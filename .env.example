# Django Core Settings
DJANGO_SECRET_KEY=replace-this-with-a-secure-50-char-random-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# Database (PostgreSQL / Neon / Supabase URL for production, falls back to SQLite locally if unset)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# CSRF Trusted Origins (comma-separated URLs with https://)
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,http://localhost:8000,http://127.0.0.1:8000

# Security (set to False if testing production mode behind local HTTP)
SECURE_SSL_REDIRECT=False
